/** @format */

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "threat-forge-web",
  "compatibility_date": "2026-07-20",
  "main": "./worker/index.ts",
  // Both stated rather than inherited. `workers_dev` already resolves to false because
  // routes are configured, and Wrangler POSTs that on every deploy; `preview_urls` has no
  // default, so it is omitted from the request body and the API keeps whatever it last
  // held. Wrangler's own warning for that combination is "to prevent this Worker from
  // being unintentionally public". A preview URL also matters more here than elsewhere:
  // it lives on workers.dev, where Cloudflare documents no functional cache operations, so
  // /api/latest-release there is an uncached 1:1 proxy to api.github.com — the exact
  // rate-limit exhaustion this Worker's cache exists to prevent.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // The Worker delegates every non-API request to this binding, so static
    // assets and the SPA fallback keep serving unchanged.
    "binding": "ASSETS",
    // Only the release-proxy route runs the Worker; every other path is served
    // directly by the Asset Worker without invoking this script.
    "run_worker_first": ["/api/latest-release"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "routes": [
    {
      "pattern": "threatforge.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.threatforge.dev",
      "custom_domain": true,
    },
  ],
}
