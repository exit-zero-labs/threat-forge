{
	"name": "threat-forge",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:web": "vite --port 3000",
		"build": "tsc && vite build",
		"build:web": "tsc && vite build",
		"preview": "vite preview",
		"preview:web": "npm run build:web && wrangler dev",
		"deploy:web": "npm run build:web && wrangler deploy",
		"check:worker": "wrangler deploy --dry-run",
		"check:worker-types": "wrangler types --include-runtime=false --check ./worker/worker-configuration.d.ts && tsc --noEmit -p tsconfig.worker.json",
		"check:e2e-types": "tsc --noEmit -p tsconfig.e2e.json",
		"tauri": "tauri",
		"check:lockfile": "node scripts/check-lockfile-registry.mjs",
		"check:tauri-versions": "node scripts/check-tauri-version-alignment.mjs",
		"check": "biome check .",
		"format": "biome check --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:agent": "node scripts/run-agent-scenario.mjs",
		"ci:local": "bash scripts/ci-local.sh",
		"ci:docker": "docker compose run --rm --build ci",
		"ci:docker:build": "docker compose run --rm --build ci bash scripts/ci-local.sh --build",
		"prepare": "bash scripts/setup-hooks.sh"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-clipboard-manager": "2.5.0",
		"@tauri-apps/plugin-dialog": "2.8.3",
		"@tauri-apps/plugin-opener": "2.7.2",
		"@xyflow/react": "^12.12.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"js-yaml": "^5.5.0",
		"lucide-react": "^1.58.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.4",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/workers-types": "5.20261016.1",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.2.1",
		"@tauri-apps/cli": "2.12.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"fake-indexeddb": "6.2.6",
		"jsdom": "^29.1.1",
		"simple-icons": "16.35.0",
		"tailwindcss": "^4.2.1",
		"typescript": "~7.0.2",
		"vite": "^8.3.4",
		"vitest": "^4.0.18",
		"wrangler": "4.151.1"
	}
}
